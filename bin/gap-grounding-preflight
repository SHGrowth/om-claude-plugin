#!/usr/bin/env bash
# gap-grounding-preflight — fail fast when the gap-analysis "upstream pipeline"
# channel (open PRs + official-modules) is dead, BEFORE Phase 2 dispatches a
# single subagent.
# Usage:  gap-grounding-preflight        (run at the top of Phase 2)
#
# Source spec: agents-master/improvements/I036.md (original channel-dead
# hole), re-scoped by agents-master/improvements/I038.md — merged-code verdict
# grounding no longer calls `gh search code` (bin/gap-validate-finding greps
# the bin/gap-orientation-preflight checkout instead), so this gate's job
# narrows to the channel that's STILL live-`gh`-bound: open PRs on
# open-mercato/open-mercato, and the official-modules repo + its PRs.
#
# Third sibling of bin/gap-validate-finding (I019/I038, the verdict layer) and
# bin/gap-checklist-gate (I024, the intake layer); bin/gap-orientation-preflight
# (I037/I038) is the fourth, guarding the local checkout.
#
# Why a reachability check, not I036's original control-term search: I036's
# control term worked because a healthy code-search ALWAYS has a non-empty
# answer for a known-present string. That doesn't transfer here — a repo can
# legitimately have zero open PRs at some point in time, so "the PR search
# returned nothing" is NOT proof the channel is dead the way an empty code
# search was. The reachability check instead asks the narrower, always-true-if-
# healthy question: can we read basic repo metadata for both repos at all?
# That's still enough to catch gh unauthed / no repo access / repo renamed —
# the same failure modes I036 cared about — without depending on PR/issue
# counts staying non-zero.
#
# Exit codes (mirror the sibling gates):
#   0  HEALTHY      — both repos reachable via gh; the PR/official-modules
#                     channel is live. Start Phase 2.
#   1  DEAD/EMPTY   — gh missing, or gh returned a PERMANENT error reaching
#                     either repo (unauthed / no access / repo renamed). DO
#                     NOT start Phase 2 — fix the environment first.
#   2  RETRY-LATER  — gh transiently rate-limited/unreachable. Wait and re-run.
#
# Scope honesty: a green preflight proves both repos are reachable — NOT that
# any individual PR/official-modules finding is correct (that's the per-story
# subagent's own job; this field is shape-checked only, never re-run, per
# I038). It also says nothing about bin/gap-orientation-preflight's checkout
# (a separate gate) — the two channels are independent and both required.

set -uo pipefail

REPOS=("open-mercato/open-mercato" "open-mercato/official-modules")
GH_SLEEP="${GH_SLEEP:-2.5}"   # match the verdict gate's throttle

fail()  { echo "PREFLIGHT DEAD [pipeline channel]: $1" >&2; exit 1; }
defer() { echo "PREFLIGHT RETRY-LATER [pipeline channel]: $1" >&2; exit 2; }

command -v gh >/dev/null 2>&1 || fail "gh CLI not found on PATH — the PR/official-modules channel is impossible without it.
  Fix: install it (macOS: \`brew install gh\`), then \`gh auth login\`. Re-run this preflight."

for REPO in "${REPOS[@]}"; do
  GH_ERRFILE="$(mktemp "${TMPDIR:-/tmp}/gap-preflight-err.XXXXXX")"
  set +e
  gh api "repos/$REPO" --jq '.id' >/dev/null 2>"$GH_ERRFILE"
  GH_RC=$?
  GH_ERR="$(cat "$GH_ERRFILE" 2>/dev/null)"; rm -f "$GH_ERRFILE"
  set -e
  sleep "$GH_SLEEP"

  if [ $GH_RC -ne 0 ]; then
    if grep -qiE "rate limit|secondary rate|\b403\b|abuse|timeout|timed out|could not resolve|connection|temporar|try again|network" <<<"$GH_ERR"; then
      defer "gh transiently unavailable reaching $REPO ($GH_RC): $(head -1 <<<"$GH_ERR")
  This is usually a rate limit — nothing to fix. Wait ~60s and re-run this preflight."
    fi
    fail "gh failed reaching $REPO ($GH_RC): $(head -1 <<<"$GH_ERR")
  Fix (most likely auth): run \`gh auth status\` — if not logged in, \`gh auth login\`.
  If $REPO was renamed/moved, that repo's PR/official-modules search will need
  updating in skills/om-cto/references/gap-analysis-batch.md. Re-run this
  preflight after fixing."
  fi
done

echo "PREFLIGHT HEALTHY [pipeline channel]: ${REPOS[*]} reachable — the Upstream pipeline channel is live; Phase 2 may start" >&2
exit 0
