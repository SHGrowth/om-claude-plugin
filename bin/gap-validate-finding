#!/usr/bin/env bash
# gap-validate-finding — structural gate for one gap-analysis findings block.
# Usage:  gap-validate-finding <story-id> --repo-root <path> [--story <file>]  < findings-block.md
#
#   --repo-root <path>  The validated upstream `develop` checkout (the stdout
#                       of bin/gap-orientation-preflight). REQUIRED whenever
#                       grounding is needed — merged-code verdicts are re-run
#                       as a local `git grep` against this checkout, not a
#                       live `gh search code` call (I038). Falls back to env
#                       GAP_REPO_ROOT if the flag is absent.
#   --story <file>      Story context (title + acceptance criteria) the verdict
#                       is about. REQUIRED to ground a ❌ Missing — without it
#                       the gate cannot prove the grounding query is
#                       non-degenerate, so the absence verdict cannot be
#                       trusted (S012 strawman guard). Falls back to env
#                       GAP_STORY if the flag is absent.
#
# Source spec: agents-master/improvements/I019.md (§4 "Inherit the gate" +
# §Verification tests 3/4), superseded for the grounding MECHANISM by
# agents-master/improvements/I038.md (local checkout replaces live gh for
# merged-code grounding). Review: docs/specs/2026-06-06-gap-validate-finding-review.md
# (findings #1 verdict-misparse, #2 degenerate-query/S012, #3 permanent-gh/flag —
# all three still apply; #3's flag-injection and permanent-vs-transient split
# now guards `git grep` invocation instead of `gh`).
# Sibling of bin/claude-validated (I018) — same reject-and-retry contract, but
# relocated into the BATCH-MODE orchestrator's parse step because the candidate
# dispatches verification via the Task tool, which claude-validated (a claude -p
# wrapper) does not intercept.
#
# Two layers, both outside the subagent's model loop (per S011/S012 /
# feedback_text_channel_does_not_bind):
#   FORM      — regex checks (I018 lineage), adapted to atomic-commit currency.
#   GROUNDING — the orchestrator RE-RUNS the cited query as a `git grep` against
#               the validated --repo-root checkout and compares the result to
#               the claimed verdict. A regex over the returned citation only
#               proves a string is present; it cannot tell a real `no match`
#               from a hallucinated one. AND the query must share a noun with
#               the story (else a strawman query self-confirms a ❌ — S012).
#               Test 4 (staleness) is unsatisfiable without the re-run.
#
# Exit codes:
#   0  PASS  — write the block to the MD.
#   1  FAIL  — block malformed, verdict contradicted by the re-run, grounding
#              query degenerate, --repo-root missing/invalid, or the query is
#              malformed (leading '-'). Orchestrator marks story needs-review
#              and re-dispatches once with reinforcement.
#
#   No exit 2 (I038): grounding is a local `git grep` against an
#   already-validated checkout, not a rate-limited network call — the
#   RETRY-LATER path I019 needed for `gh` has no equivalent failure mode here.
#
# Scope honesty (I019 §88 — these holes remain, by design):
#   - Falsifier, not confirmer: a grep hit proves a string matches, not that
#     the matched code satisfies the story's acceptance criteria.
#   - A "checkout"-sourced ✅/🟡 is accepted on shape-trust only when its
#     grounding source says so AND the story's own re-run below still agrees
#     for grounding-required verdicts; a fabricated positive under a
#     `develop`-only checkout is caught downstream at implementation, not here.
#   The S012 strawman hole on the ❌ path is now CLOSED by the story-token guard
#   below (review #2); it is no longer deferred to v2.

set -euo pipefail

STORY_ID="${1:-?}"; [ $# -gt 0 ] && shift || true
REPO_ROOT="${GAP_REPO_ROOT:-}"
STORY_CONTEXT="${GAP_STORY:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --repo-root)   REPO_ROOT="${2:-}"; shift 2 || true ;;
    --repo-root=*) REPO_ROOT="${1#--repo-root=}"; shift ;;
    --story)       STORY_CONTEXT="$(cat "${2:-/dev/null}" 2>/dev/null || true)"; shift 2 || true ;;
    --story=*)     STORY_CONTEXT="$(cat "${1#--story=}" 2>/dev/null || true)"; shift ;;
    *)             shift ;;
  esac
done

BLOCK="$(cat)"

fail() { echo "GATE FAIL [$STORY_ID]: $1" >&2; exit 1; }

# Returns 0 (true = degenerate) when QUERY shares no noun token with the story.
# Stem-matches on the first 5 chars so plural/inflection (appointment/appointments)
# still ties. Path/stopword noise is stripped so `modules/<x>` matches on `<x>`.
degenerate_query() {
  local q="$1" story="$2" storylc qtokens t stem
  storylc="$(printf '%s' "$story" | tr 'A-Z' 'a-z')"
  qtokens="$(printf '%s' "$q" | tr -c '[:alnum:]' ' ' | tr 'A-Z' 'a-z' | tr ' ' '\n' \
             | grep -vE '^(modules?|packages?|src|code|open|mercato|the|and|for|with|api|app|page|pages|new|core|ui)$' \
             | awk 'length($0)>=4' || true)"
  [ -z "$qtokens" ] && return 0   # no usable noun → degenerate
  while IFS= read -r t; do
    [ -z "$t" ] && continue
    stem="${t:0:5}"
    case "$storylc" in *"$stem"*) return 1 ;; esac   # shared noun → NOT degenerate
  done <<< "$qtokens"
  return 0   # nothing shared → degenerate
}

# ---------------------------------------------------------------------------
# FORM checks (deterministic regex, no network)
# ---------------------------------------------------------------------------

# 1 — no percentage without an explicit fraction (I018 check 1)
if grep -qE "[0-9]+(\.[0-9]+)?%" <<<"$BLOCK" && ! grep -qE "[0-9]+/[0-9]+" <<<"$BLOCK"; then
  fail "percentage emitted without N/M fraction"
fi

# 2 — no hedges (I018 check 2; English + the Polish hedges S011 surfaced)
if grep -iqE "\b(approximately|around|roughly|approx\.|szacunkowo|około|mniej więcej|w przybliżeniu)\b" <<<"$BLOCK" \
   || grep -qE "~[0-9]" <<<"$BLOCK"; then
  fail "hedge word before an unmeasured number (output must be measured or absent)"
fi

# 3 — no persona labels (I018 check 3)
if grep -iqE "\b(piotr|cagan|piotr-style|cagan-style)\b" <<<"$BLOCK"; then
  fail "persona invoked as label"
fi

# 4 — currency: no T-shirt sizes leaked (I019 currency-regression, test 5).
#     Effort MUST be an atomic-commit score, never XS/S/M/L/XL. Applies always.
if grep -qE "\*\*Effort\*\*:[[:space:]]*\b(XS|S|M|L|XL)\b" <<<"$BLOCK"; then
  fail "T-shirt effort size leaked — effort must be an atomic-commit score 0–5"
fi

# 5 — Upstream pipeline (I038): a required, non-verdict-altering field — shape
#     only, never re-run. Recognized values: none | PR #<n> (open) |
#     official-modules PR #<n> (open) | spec: <path> (planned, unbuilt).
#     Applies regardless of verdict — an Unclear story can still have an open PR.
UPLINE="$(grep -E "\*\*Upstream pipeline\*\*:" <<<"$BLOCK" | head -1 \
          | sed -E 's/.*\*\*Upstream pipeline\*\*:[[:space:]]*//; s/[[:space:]]*$//' || true)"
[ -n "$UPLINE" ] || fail "missing **Upstream pipeline** field (required — use 'none' if nothing found)"
# Shell case-glob, not regex: `[0-9]*[0-9]` means "a digit, ANY characters,
# then a digit" — it rejects single-digit numbers (needs 2+ chars) and accepts
# non-numeric junk in between (`1abc2` matches). Use bash's regex operator
# instead, with the pattern in a variable (inline `[[ =~ ]]` patterns don't
# reliably honor escapes like `\#`/`\(` on this target's bash 3.2).
UPLINE_NONE='^[Nn]one$'
UPLINE_PR='^PR #[0-9]+ \(open\)$'
UPLINE_OFFICIAL='^official-modules PR #[0-9]+ \(open\)$'
UPLINE_SPEC='^spec: .+ \(planned, unbuilt\)$'
if [[ "$UPLINE" =~ $UPLINE_NONE || "$UPLINE" =~ $UPLINE_PR || "$UPLINE" =~ $UPLINE_OFFICIAL || "$UPLINE" =~ $UPLINE_SPEC ]]; then
  :
else
  fail "unrecognized **Upstream pipeline** value: '$UPLINE' (expected: none | PR #<n> (open) | official-modules PR #<n> (open) | spec: <path> (planned, unbuilt))"
fi

# ---------------------------------------------------------------------------
# Parse the verdict. The EMOJI is authoritative (review #1): a positive line
# that merely contains the word "Missing" must NOT classify as missing. Fall
# back to the verdict WORD only when no emoji is present, and only as the
# leading token of the verdict value — never a substring anywhere in the line.
# ---------------------------------------------------------------------------
VERDICT_LINE="$(grep -E "\*\*Verdict\*\*:" <<<"$BLOCK" | head -1 || true)"
[ -n "$VERDICT_LINE" ] || fail "no **Verdict** line"

if   grep -q "✅" <<<"$VERDICT_LINE"; then VERDICT="implemented"
elif grep -q "🟡" <<<"$VERDICT_LINE"; then VERDICT="partial"
elif grep -q "❌" <<<"$VERDICT_LINE"; then VERDICT="missing"
elif grep -q "⚠️" <<<"$VERDICT_LINE"; then VERDICT="unclear"
else
  VVAL="$(sed -E 's/.*\*\*Verdict\*\*:[[:space:]]*//' <<<"$VERDICT_LINE")"
  case "$VVAL" in
    [Ii]mplemented*) VERDICT="implemented" ;;
    [Pp]artial*)     VERDICT="partial" ;;
    [Mm]issing*)     VERDICT="missing" ;;
    [Uu]nclear*)     VERDICT="unclear" ;;
    *) fail "unrecognized verdict (no emoji, no leading verdict word): $VERDICT_LINE" ;;
  esac
fi

# ⚠️ Unclear is an honest non-verdict — no capability claim to ground, no effort required.
if [ "$VERDICT" = "unclear" ]; then
  echo "GATE PASS [$STORY_ID]: ⚠️ Unclear — no capability claim to ground" >&2
  exit 0
fi

# 5 — effort present as an atomic-commit score 0–5 (currency inherited, not forked).
if ! grep -qE "\*\*Effort\*\*:[[:space:]]*[0-5]\b" <<<"$BLOCK"; then
  fail "missing or non-numeric atomic-commit effort score (expected 0–5)"
fi

# ---------------------------------------------------------------------------
# GROUNDING — re-run the cited query as a local search (verdict-conditional,
# I019 §4 + source rule, mechanism replaced per I038)
# ---------------------------------------------------------------------------
QUERY="$(grep -E "\*\*Grounding query\*\*:" <<<"$BLOCK" | head -1 \
         | sed -E 's/.*\*\*Grounding query\*\*:[[:space:]]*//; s/^`//; s/`[[:space:]]*$//' || true)"
GSOURCE="$(grep -E "\*\*Grounding source\*\*:" <<<"$BLOCK" | head -1 \
           | sed -E 's/.*\*\*Grounding source\*\*:[[:space:]]*//; s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]' || true)"

# Grounding is REQUIRED for ❌ Missing (always) and for ✅/🟡 whose source is the
# vendored snapshot. A `checkout` ✅/🟡 (I038 — was `live` pre-I038, meaning "I
# read this straight from the validated REPO_ROOT checkout") is accepted on
# shape-trust (I019 §88, hole 3).
NEEDS_GROUNDING=0
case "$VERDICT" in
  missing) NEEDS_GROUNDING=1 ;;
  implemented|partial) [ "$GSOURCE" = "checkout" ] || NEEDS_GROUNDING=1 ;;
esac

if [ "$NEEDS_GROUNDING" = 0 ]; then
  echo "GATE PASS [$STORY_ID]: $VERDICT (checkout citation accepted on shape-trust per I019 §88)" >&2
  exit 0
fi

[ -n "$QUERY" ] || fail "verdict '$VERDICT' requires grounding but no **Grounding query** field was emitted"

# Review #3: a query beginning with '-' is malformed (parses as a flag).
case "$QUERY" in
  -*) fail "grounding query may not begin with '-' ('$QUERY')" ;;
esac

# Review #2 (S012): the grounding query must be tied to the story, or a strawman
# query self-confirms the verdict.
if [ "$VERDICT" = "missing" ]; then
  # A ❌ is only trustworthy if its query provably references the story. No story
  # context → cannot prove non-degeneracy → cannot trust the absence.
  [ -n "$STORY_CONTEXT" ] || fail "❌ Missing requires story context to verify the grounding query is non-degenerate (S012 strawman guard); pass --story <file>"
  if degenerate_query "$QUERY" "$STORY_CONTEXT"; then
    fail "degenerate grounding query '$QUERY' shares no noun with the story — a strawman absence (S012)"
  fi
elif [ -n "$STORY_CONTEXT" ]; then
  # vendored ✅/🟡: token check when context is available (backward-compatible
  # when it isn't — the re-run below still runs).
  if degenerate_query "$QUERY" "$STORY_CONTEXT"; then
    fail "degenerate grounding query '$QUERY' shares no noun with the story (S012)"
  fi
fi

[ -n "$REPO_ROOT" ] || fail "verdict '$VERDICT' requires grounding but no --repo-root was provided (pass the path bin/gap-orientation-preflight printed, or set GAP_REPO_ROOT)"
git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
  fail "--repo-root '$REPO_ROOT' is not a git checkout — run bin/gap-orientation-preflight first and pass its stdout here"

# Prefer rg (faster, respects .gitignore) when present; fall back to git grep.
# Both share the same exit-code convention: 0 = match, 1 = no match (not an
# error), >=2 = a real error (bad pattern, unreadable path, etc).
local_search() {
  local root="$1" query="$2"
  if command -v rg >/dev/null 2>&1; then
    rg --no-messages -il -- "$query" "$root"
  else
    git -C "$root" grep -riIl -- "$query"
  fi
}

set +e
SEARCH_OUT="$(local_search "$REPO_ROOT" "$QUERY" 2>&1)"
SEARCH_RC=$?
set -e

if [ "$SEARCH_RC" -gt 1 ]; then
  fail "local search error for query \"$QUERY\" against $REPO_ROOT: $(head -1 <<<"$SEARCH_OUT")"
fi

HITS=0
[ "$SEARCH_RC" -eq 0 ] && HITS=1

if [ "$VERDICT" = "missing" ] && [ "$HITS" = 1 ]; then
  fail "❌ Missing contradicted — \`$QUERY\` has hits in $REPO_ROOT (stale/ungrounded absence — the TagsInput trap)"
fi
if { [ "$VERDICT" = "implemented" ] || [ "$VERDICT" = "partial" ]; } && [ "$HITS" = 0 ]; then
  fail "$VERDICT claimed but \`$QUERY\` has no hits in $REPO_ROOT (empty positive)"
fi

echo "GATE PASS [$STORY_ID]: $VERDICT grounded — local re-run of \"$QUERY\" against $REPO_ROOT agrees" >&2
exit 0
